DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/realm_labs_crm
REDIS_URL=redis://127.0.0.1:6379
ADMIN_EMAIL=nathan@realmlabs.co
ALLOWED_HOSTED_DOMAIN=realmlabs.co
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001
SESSION_SECRET=dev-session-secret-change-me-32chars
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Mailbox connect reuses GOOGLE_REDIRECT_URI so it matches the login callback
# already allowlisted on the Google OAuth client.
# Operator mailboxes: nathan@realmlabs.co and stefano@realmlabs.co (Gmail + Calendar).
TOKEN_ENCRYPTION_KEY=
# HMAC key for email suppression hashes. 64 hex chars (32 bytes). Never rotate.
# API and worker boot store a fingerprint in email_hash_key_state and refuse
# to start if this value changes — rotating orphans every tombstone.
# Gmail opt-out extraction writes the same tombstone as Postmark/API.
EMAIL_HASH_KEY=
RESUME_STORAGE_DIR=data/resumes
# Worker health port (defaults to 3002). Fly/Docker may set PORT instead.
WORKER_HEALTH_PORT=3002
APPLICATION_WEBHOOK_SECRET=change-me-application-webhook-secret
WEBSITE_INTAKE_SECRET=change-me-website-intake-secret
WEBSITE_ORIGIN=http://localhost:4321
STRIPE_ENABLED=false
STRIPE_WEBHOOK_SECRET=

# Sequence tool pull/send. Bearer token for GET /api/campaign-tags and POST /api/sends.
CAMPAIGN_SYNC_SECRET=
# Optional outbound webhook on tag change (worker). HMAC-SHA256 hex in X-Realm-Signature.
CAMPAIGN_TAG_WEBHOOK_URL=
CAMPAIGN_TAG_WEBHOOK_SECRET=

# Postmark Broadcast stream on mail.realmlabs.co, never @realmlabs.co.
# That keeps campaign reputation off every operator mailbox on the apex
# (nathan@, stefano@, and operators added later).
# GET /api/unsubscribe is confirm-only (POST writes). Drain claims
# queued → sending before Postmark. The webhook writes the event row and
# tombstone in one transaction. Keep POSTMARK_SEND_ENABLED=false until a
# Postmark "Verify webhook" returns 200 and ALERT_WEBHOOK_URL reaches a phone.
CAMPAIGN_FROM_EMAIL=hello@mail.realmlabs.co
CAMPAIGN_FROM_NAME=Realm Labs
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=broadcast
POSTMARK_WEBHOOK_USER=
POSTMARK_WEBHOOK_PASSWORD=
POSTMARK_SEND_ENABLED=false
# Slack incoming webhook (or any URL that accepts {"text": "..."}). Required
# before POSTMARK_SEND_ENABLED=true — drain halt and worker failures POST here
# so they hit your phone, not just stdout.
ALERT_WEBHOOK_URL=
# Kickbox: new website form intake only. Not applications, not people we already email.
KICKBOX_API_KEY=
# Own Gmail/Outlook/Yahoo addresses; every campaign goes here before real recipients.
SEND_SEED_EMAILS=


# Production (realmlabscrm.com) — Fly, or docker-compose.prod.yml
# POSTGRES_PASSWORD=
# CADDY_EMAIL=nathan@realmlabs.co
# WEB_ORIGIN=https://realmlabscrm.com
# API_ORIGIN=https://realmlabscrm.com
# GOOGLE_REDIRECT_URI=https://realmlabscrm.com/api/auth/google/callback
# Fly web machine only — private API hostname for middleware proxying:
# FLY_API_APP=realm-labs-crm-api
# BACKUP_S3_BUCKET=
# BACKUP_S3_ENDPOINT=https://sfo3.digitaloceanspaces.com
# BACKUP_S3_REGION=sfo3
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_RETENTION_DAYS=30
