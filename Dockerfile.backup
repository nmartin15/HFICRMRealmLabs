FROM postgres:16-bookworm

ARG TARGETARCH

RUN apt-get update \
  && apt-get install -y --no-install-recommends awscli ca-certificates curl \
  && curl -fsSL "https://github.com/aptible/supercronic/releases/download/v0.2.33/supercronic-linux-${TARGETARCH}" \
    -o /usr/local/bin/supercronic \
  && chmod +x /usr/local/bin/supercronic \
  && rm -rf /var/lib/apt/lists/*

COPY deploy/backup.sh /usr/local/bin/backup.sh
COPY deploy/crontab /crontab
RUN sed -i 's/\r$//' /usr/local/bin/backup.sh /crontab \
  && chmod +x /usr/local/bin/backup.sh

ENV TZ=America/Los_Angeles
ENV BACKUP_RETENTION_DAYS=30

CMD ["supercronic", "/crontab"]
