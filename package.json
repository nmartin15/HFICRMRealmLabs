{
  "name": "realm-labs-crm",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:generate": "pnpm --filter @realm-labs/db generate",
    "db:migrate": "pnpm --filter @realm-labs/db migrate",
    "db:seed": "pnpm --filter @realm-labs/db seed",
    "db:studio": "pnpm --filter @realm-labs/db studio"
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "msgpackr-extract", "sharp", "unrs-resolver"]
  }
}
